# JWT Configuration
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-strong-random-secret-here-at-least-32-characters

# Cloudflare KV Binding Name (must match wrangler.toml)
KV_BINDING_NAME=CAPTCHA_KV

# Application URL (for CORS and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:8788

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000
