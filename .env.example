# JWT Configuration
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-strong-random-secret-here-at-least-32-characters

# Supabase (data store)
# Required for production (Vercel): use the Service Role key (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: table name (default: verification_codes)
SUPABASE_CODES_TABLE=verification_codes

# Vercel Cron (protect /api/cron/* endpoints)
CRON_SECRET=your-cron-secret
 
# Application URL (for CORS and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:8788

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000

# Admin Secret (for admin API endpoints)
ADMIN_SECRET=your-admin-secret
